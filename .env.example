# ================== Servidor ==================
PORT=3000
# Cambia este valor por una cadena larga y aleatoria
JWT_SECRET=cambia-esta-clave-por-una-muy-larga-y-secreta
JWT_EXPIRES=8h
# Minutos que un asiento queda bloqueado mientras el cliente paga
HOLD_MINUTES=10

# ================== SQL Server ==================
DB_NAME=BusGlowDB
# Conexiones simultáneas a la base (por defecto 30). Si una prueba de carga muestra
# "TimeoutError: operation timed out", súbelo (p. ej. 50).
DB_POOL_MAX=30
# Espera máxima por una conexión libre y por una consulta (milisegundos)
DB_POOL_ESPERA_MS=15000
DB_TIMEOUT_MS=30000
# Hilos de trabajo de Node (por defecto de Node: 4). msnodesqlv8 ejecuta cada consulta en uno de
# estos hilos, así que con 4 solo avanzan 4 consultas a la vez. BusGlow usa 64 si no se indica.
UV_THREADPOOL_SIZE=64

# --- OPCIÓN A (recomendada): autenticación de SQL Server (usuario + contraseña) ---
DB_DRIVER=tedious
DB_SERVER=localhost
# Usa DB_PORT si habilitaste TCP/IP con puerto fijo 1433 (recomendado)...
DB_PORT=1433
# ...o deja DB_PORT vacío y usa el nombre de instancia (requiere el servicio "SQL Server Browser" iniciado)
DB_INSTANCE=
DB_USER=busglow_app
DB_PASSWORD=BusGlow2026!

# --- OPCIÓN B: autenticación de Windows (sin usuario/contraseña) ---
# Requiere: npm install msnodesqlv8   y tener instalado "ODBC Driver 17/18 for SQL Server"
# DB_DRIVER=msnodesqlv8
# DB_SERVER=localhost\SQLEXPRESS
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
