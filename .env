# =====================================================================
#  BusGlow · Variables para Azure (copia de referencia)
#  - En Azure App Service NO se sube este archivo: estos valores se cargan en
#    Web App > Configuración > Variables de entorno.
#  - Para cargar la base de Azure desde tu PC (npm run db:init), copia este
#    archivo como .env, completa los datos y luego vuelve a tu .env local.
# =====================================================================

# Servidor de Azure SQL Database (usuario y contraseña de SQL, no de Windows)
DB_DRIVER=tedious
DB_SERVER=busglow-sql-grupo1.database.windows.net
DB_PORT=1433
DB_NAME=BusGlowDB
DB_USER=busglowadmin
DB_PASSWORD=S0p0rt3@2025$$

# Azure SQL exige conexión cifrada (se activa sola con *.database.windows.net)
DB_ENCRYPT=true

# Plan gratuito: pocas conexiones simultáneas bastan
DB_POOL_MAX=10
DB_POOL_ESPERA_MS=15000
DB_TIMEOUT_MS=30000

# Hora del Perú (Azure trabaja en UTC)
TZ=America/Lima
DB_ZONA_HORARIA=SA Pacific Standard Time

# Clave para firmar las sesiones: usa una cadena larga y aleatoria
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria
JWT_EXPIRES=8h
