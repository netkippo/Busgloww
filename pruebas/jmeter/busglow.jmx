<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BusGlow - Prueba de rendimiento"><stringProp name="TestPlan.comments">Escenarios: lectura, compra completa, doble venta simultánea y panel. Los grupos se ejecutan uno tras otro. Los valores se cambian en busglow.properties o con -Jpropiedad=valor. RNF de rendimiento: responder en máximo 3 s.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables"><collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(port,3000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PROTOCOLO" elementType="Argument"><stringProp name="Argument.name">PROTOCOLO</stringProp><stringProp name="Argument.value">${__P(protocolo,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USUARIOS_LECTURA" elementType="Argument"><stringProp name="Argument.name">USUARIOS_LECTURA</stringProp><stringProp name="Argument.value">${__P(usuarios_lectura,50)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="RAMPA_LECTURA" elementType="Argument"><stringProp name="Argument.name">RAMPA_LECTURA</stringProp><stringProp name="Argument.value">${__P(rampa_lectura,30)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DURACION_LECTURA" elementType="Argument"><stringProp name="Argument.name">DURACION_LECTURA</stringProp><stringProp name="Argument.value">${__P(duracion_lectura,180)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USUARIOS_COMPRA" elementType="Argument"><stringProp name="Argument.name">USUARIOS_COMPRA</stringProp><stringProp name="Argument.value">${__P(usuarios_compra,20)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="RAMPA_COMPRA" elementType="Argument"><stringProp name="Argument.name">RAMPA_COMPRA</stringProp><stringProp name="Argument.value">${__P(rampa_compra,20)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DURACION_COMPRA" elementType="Argument"><stringProp name="Argument.name">DURACION_COMPRA</stringProp><stringProp name="Argument.value">${__P(duracion_compra,180)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USUARIOS_CARRERA" elementType="Argument"><stringProp name="Argument.name">USUARIOS_CARRERA</stringProp><stringProp name="Argument.value">${__P(usuarios_carrera,30)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="RAMPA_CARRERA" elementType="Argument"><stringProp name="Argument.name">RAMPA_CARRERA</stringProp><stringProp name="Argument.value">${__P(rampa_carrera,5)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USUARIOS_ADMIN" elementType="Argument"><stringProp name="Argument.name">USUARIOS_ADMIN</stringProp><stringProp name="Argument.value">${__P(usuarios_admin,5)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="RAMPA_ADMIN" elementType="Argument"><stringProp name="Argument.name">RAMPA_ADMIN</stringProp><stringProp name="Argument.value">${__P(rampa_admin,5)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DURACION_ADMIN" elementType="Argument"><stringProp name="Argument.name">DURACION_ADMIN</stringProp><stringProp name="Argument.value">${__P(duracion_admin,120)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PAUSA_MIN_MS" elementType="Argument"><stringProp name="Argument.name">PAUSA_MIN_MS</stringProp><stringProp name="Argument.value">${__P(pausa_min_ms,1000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PAUSA_RANGO_MS" elementType="Argument"><stringProp name="Argument.name">PAUSA_RANGO_MS</stringProp><stringProp name="Argument.value">${__P(pausa_rango_ms,2000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DIAS_BUSQUEDA" elementType="Argument"><stringProp name="Argument.name">DIAS_BUSQUEDA</stringProp><stringProp name="Argument.value">${__P(dias_busqueda,20)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="CARRERA_ORIGEN" elementType="Argument"><stringProp name="Argument.name">CARRERA_ORIGEN</stringProp><stringProp name="Argument.value">${__P(carrera_origen,Lima)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="CARRERA_DESTINO" elementType="Argument"><stringProp name="Argument.name">CARRERA_DESTINO</stringProp><stringProp name="Argument.value">${__P(carrera_destino,Cusco)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="FECHA_CARRERA" elementType="Argument"><stringProp name="Argument.name">FECHA_CARRERA</stringProp><stringProp name="Argument.value">${__timeShift(yyyy-MM-dd,,P${__P(carrera_dias,25)}D,,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="ADMIN_CORREO" elementType="Argument"><stringProp name="Argument.name">ADMIN_CORREO</stringProp><stringProp name="Argument.value">${__P(admin_correo,admin@busglow.pe)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="ADMIN_PASSWORD" elementType="Argument"><stringProp name="Argument.name">ADMIN_PASSWORD</stringProp><stringProp name="Argument.value">${__P(admin_password,Admin123!)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="TestPlan.user_define_classpath"></stringProp></TestPlan><hashTree><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Servidor BusGlow (valores por defecto HTTP)"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">${PROTOCOLO}</stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path"></stringProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">60000</stringProp></ConfigTestElement><hashTree></hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cabeceras JSON"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Preparación (setUp)"><stringProp name="TestPlan.comments">Verifica que el servidor responda y elige el viaje y el asiento que se disputarán en la prueba de doble venta.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></SetupThreadGroup><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Salud del servidor y la base"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">/api/health</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp><stringProp name="HTTPSampler.connect_timeout"></stringProp><stringProp name="HTTPSampler.response_timeout"></stringProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="La API y SQL Server responden (si falla, revisa npm start y la base)"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">1</intProp></ResponseAssertion><hashTree></hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Buscar viaje para la doble venta"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">/api/viajes/buscar?origen=${CARRERA_ORIGEN}&amp;destino=${CARRERA_DESTINO}&amp;fecha=${FECHA_CARRERA}&amp;pasajeros=1</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp><stringProp name="HTTPSampler.connect_timeout"></stringProp><stringProp name="HTTPSampler.response_timeout"></stringProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código HTTP 200"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">1</intProp></ResponseAssertion><hashTree></hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Primer viaje"><stringProp name="JSONPostProcessor.referenceNames">carrera_viaje</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.viajes[0].id_viaje</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp><boolProp name="JSONPostProcessor.compute_concat">false</boolProp></JSONPostProcessor><hashTree></hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Asientos del viaje de la doble venta"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">/api/viajes/${carrera_viaje}/asientos</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp><stringProp name="HTTPSampler.connect_timeout"></stringProp><stringProp name="HTTPSampler.response_timeout"></stringProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código HTTP 200"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">1</intProp></ResponseAssertion><hashTree></hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Primer asiento disponible"><stringProp name="JSONPostProcessor.referenceNames">carrera_asiento</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.asientos[?(@.estado == 'Disponible')].id_asiento</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp><boolProp name="JSONPostProcessor.compute_concat">false</boolProp></JSONPostProcessor><hashTree></hashTree></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Publicar datos de la doble venta"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">props.put('carrera_viaje', vars.get('carrera_viaje'))
props.put('carrera_asiento', vars.get('carrera_asiento'))
props.put('ganadores', new java.util.concurrent.atomic.AtomicInteger(0))
props.put('conflictos', new java.util.concurrent.atomic.AtomicInteger(0))
props.put('otros', new java.util.concurrent.atomic.AtomicInteger(0))
SampleResult.setResponseData('Viaje ' + vars.get('carrera_viaje') + ', asiento ' + vars.get('carrera_asiento'), 'UTF-8')
if (vars.get('carrera_viaje') == 'NOT_FOUND' || vars.get('carrera_asiento') == 'NOT_FOUND') {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('No se encontró un viaje con asientos libres para la prueba de doble venta: revisa CARRERA_ORIGEN/DESTINO/DIAS o ejecuta npm run db:init')
}</stringProp></JSR223Sampler><hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="1. Búsqueda y asientos (solo lectura)"><stringProp name="TestPlan.comments">Visitantes que buscan y comparan viajes: la operación más frecuente del sistema.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${USUARIOS_LECTURA}</stringProp><stringProp name="ThreadGroup.ramp_time">${RAMPA_LECTURA}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${DURACION_LECTURA}</stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Rutas a buscar (rutas.csv)"><stringProp name="filename">rutas.csv</stringProp><stringProp name="fileEncoding">UTF-8</stringProp><stringProp name="variableNames">origen,destino</stringProp><boolProp name="ignoreFirstLine">true</boolProp><stringProp name="delimiter">,</stringProp><boolProp name="quotedData">false</boolProp><boolProp name="recycle">true</boolProp><boolProp name="stopThread">false</boolProp><stringProp name="shareMode">shareMode.all</stringProp></CSVDataSet><hashTree></hashTree><UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Tiempo de lectura del usuario (1 a 3 s)"><stringProp name="ConstantTimer.delay">${PAUSA_MIN_MS}</stringProp><stringProp name="RandomTimer.range">${PAUSA_RANGO_MS}</stringProp></UniformRandomTimer><hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="1.1 Inicio: ciudades"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">/api/ciudades</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp><stringProp name="HTTPSampler.connect_timeout"></stringProp><stringProp name="HTTPSampler.response_timeout"></stringProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código HTTP 200"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">1</intProp></ResponseAssertion><hashTree></hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="1.2 Inicio: rutas populares"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">/api/rutas/populares</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp><stringProp name="HTTPSampler.connect_timeout"></stringProp><stringProp name="HTTPSampler.response_timeout"></stringProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código HTTP 200"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">1</intProp></ResponseAssertion><hashTree></hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="1.3 Buscar viajes"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">/api/viajes/buscar?origen=${origen}&amp;destino=${destino}&amp;fecha=${__timeShift(yyyy-MM-dd,,P${__Random(1,${DIAS_BUSQUEDA},)}D,,)}&amp;pasajeros=${__Random(1,3,)}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp><stringProp name="HTTPSampler.connect_timeout"></stringProp><stringProp name="HTTPSampler.response_timeout"></stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Limpiar variables de la iteración anterior"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">vars.put('id_viaje', 'NOT_FOUND'); vars.put('id_asiento', 'NOT_FOUND'); vars.put('id_reserva', 'NOT_FOUND')</stringProp></JSR223PreProcessor><hashTree></hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código HTTP 200"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">1</intProp></ResponseAssertion><hashTree></hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Elegir un viaje al azar"><stringProp name="JSONPostProcessor.referenceNames">id_viaje</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.viajes[*].id_viaje</stringProp><stringProp name="JSONPostProcessor.match_numbers">0</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp><boolProp name="JSONPostProcessor.compute_concat">false</boolProp></JSONPostProcessor><hashTree></hashTree></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname