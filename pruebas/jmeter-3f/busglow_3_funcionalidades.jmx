<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BusGlow - 3 funcionalidades"><stringProp name="TestPlan.comments">F1 Inicio de sesión, F2 Búsqueda de viajes y F3 Compra de pasaje, en paralelo (carga mixta). Cambia usuarios, rampa y duración en Variables o con -Jusuarios_busqueda=80. RNF: responder en máximo 3 s.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables"><collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(port,3000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PROTOCOLO" elementType="Argument"><stringProp name="Argument.name">PROTOCOLO</stringProp><stringProp name="Argument.value">${__P(protocolo,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USUARIOS_LOGIN" elementType="Argument"><stringProp name="Argument.name">USUARIOS_LOGIN</stringProp><stringProp name="Argument.value">${__P(usuarios_login,10)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USUARIOS_BUSQUEDA" elementType="Argument"><stringProp name="Argument.name">USUARIOS_BUSQUEDA</stringProp><stringProp name="Argument.value">${__P(usuarios_busqueda,40)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="USUARIOS_COMPRA" elementType="Argument"><stringProp name="Argument.name">USUARIOS_COMPRA</stringProp><stringProp name="Argument.value">${__P(usuarios_compra,10)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="RAMPA" elementType="Argument"><stringProp name="Argument.name">RAMPA</stringProp><stringProp name="Argument.value">${__P(rampa,60)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DURACION" elementType="Argument"><stringProp name="Argument.name">DURACION</stringProp><stringProp name="Argument.value">${__P(duracion,300)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PAUSA_MIN_MS" elementType="Argument"><stringProp name="Argument.name">PAUSA_MIN_MS</stringProp><stringProp name="Argument.value">${__P(pausa_min_ms,1000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PAUSA_RANGO_MS" elementType="Argument"><stringProp name="Argument.name">PAUSA_RANGO_MS</stringProp><stringProp name="Argument.value">${__P(pausa_rango_ms,2000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DIAS_BUSQUEDA" elementType="Argument"><stringProp name="Argument.name">DIAS_BUSQUEDA</stringProp><stringProp name="Argument.value">${__P(dias_busqueda,20)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="LOGIN_CORREO" elementType="Argument"><stringProp name="Argument.name">LOGIN_CORREO</stringProp><stringProp name="Argument.value">${__P(login_correo,juan.perez@email.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="LOGIN_PASSWORD" elementType="Argument"><stringProp name="Argument.name">LOGIN_PASSWORD</stringProp><stringProp name="Argument.value">${__P(login_password,Cliente123)}</stringProp><stringProp name="Argument.metadata">=</stri